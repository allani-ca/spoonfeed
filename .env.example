# Spoonfeed Configuration Example

FEEDGEN_LISTEN=":4040"
FEEDGEN_HOSTNAME="spoonfeed.devsky.app"
FEEDGEN_SERVICE_DID="did:web:spoonfeed.devsky.app"
FEEDGEN_ACTORS_PATH="/pds/actors"
FEEDGEN_REFRESH="30s"
FEEDGEN_MAX_AGE="720h"
FEEDGEN_FEED_URI="at://did:plc:YOUR_DID/app.bsky.feed.generator/YOUR_FEED_RKEY"

FEEDGEN_PUBLISHER_HANDLE="operator.devsky.app"
FEEDGEN_PUBLISHER_DID="did:plc:YOUR_DID"
FEEDGEN_PUBLISHER_APP_PASSWORD="your-app-password"
